# Resend (https://resend.com/docs/api-reference/introduction)
# Create a key at https://resend.com/api-keys — never commit real keys or paste them in chat.
RESEND_API_KEY=

# Sender must use a domain verified in Resend (e.g. mail.tego-group.com)
RESEND_FROM_EMAIL="Tego Group <noreply@mail.tego-group.com>"

# Inbox for contact form + job applications
RESEND_TO_EMAIL=hello@tego-group.com

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Create a widget for www.tego-group.com (and localhost for local testing).
# Site key is public (Vite); secret key stays server-only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
